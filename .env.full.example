# Copy to .env; fill secrets with independently generated random hex strings.
# MCP token must contain at least 64 hex characters (32 random bytes).
MCP_SERVICE_TOKEN=
POSTGRES_PASSWORD=
WORKFLOW_DB_PASSWORD=
DOMAIN_DB_PASSWORD=
CHECKPOINT_DB_PASSWORD=
APP_ENV=local
LLM_MODE=scripted
# Alternatives: healthy, unknown, timeout, contradictory
SCENARIO_ID=greenshop_expired
SCENARIO_CLOCK=2026-10-18T09:00:00Z
DEMO_TIMEZONE=Asia/Jerusalem
API_PORT=8011
WEB_PORT=8091

OPENAI_API_KEY=
OPENAI_MODEL=

# Stage 3 limits may be lowered from these portfolio defaults.
OPENAI_REASONING_EFFORT=low
AGENT_MAX_READS=15
AGENT_MAX_LLM_ATTEMPTS=10
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOKENS=30000
AGENT_ACTIVE_SECONDS=120

JAEGER_PORT=16696
# Reserved for F03; no OIDC service in F01.
OIDC_PORT=8181

# Local synthetic scope only; F03/F04 replace it with verified identity/membership.
LOCAL_DEMO_TENANT=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa

# F03 independent local identity secrets
IDENTITY_DB_PASSWORD=
SESSION_SIGNING_KEY=
OIDC_BOOTSTRAP_PASSWORD=
OIDC_DEMO_PASSWORD=
APP_ORIGIN=http://127.0.0.1:8091
ALLOW_DEMO_SELF_APPROVAL=true
